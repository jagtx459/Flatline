{
  "name": "flatline",
  "version": "1.0.0",
  "description": "Monitor ICMP/HTTP endpoints, to arm scripts for graceful shutdown or migrate infrastructure.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node dev/start.js",
    "dev:tests": "node dev/start.js --tests",
    "tests": "node dev/run-tests.js",
    "tests:k8s": "node dev/run-tests.js --k8s"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "nodemailer": "^9.0.3",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
